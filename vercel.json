* {
  box-sizing: border-box;
}

:root {
  --bg: #f3faf4;
  --panel: #ffffff;
  --panel-strong: #eaf8ee;
  --primary: #2d7d46;
  --primary-dark: #1f5e39;
  --text: #1d2d1f;
  --muted: #637766;
  --danger: #b22f2f;
  --border: rgba(32, 59, 37, 0.08);
  --shadow: rgba(18, 40, 23, 0.1);
}

html, body, #root {
  height: 100%;
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, var(--bg) 0%, #edf7ee 100%);
  color: var(--text);
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
}

.auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth-card {
  width: min(100%, 460px);
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 32px 28px;
  box-shadow: 0 28px 44px var(--shadow);
}

.auth-card h1 {
  margin: 0 0 8px;
  color: var(--primary);
}

.muted {
  color: var(--muted);
  margin-bottom: 20px;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.auth-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--text);
  font-weight: 600;
}

.auth-form input,
.auth-form select {
  height: 48px;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0 12px;
  background: #f9fbf9;
  color: var(--text);
}

.primary-btn,
.secondary-btn {
  border: none;
  border-radius: 12px;
  height: 48px;
  font-weight: 700;
  transition: transform 0.2s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--primary) 0%, #5cb784 100%);
  color: white;
}

.secondary-btn {
  background: var(--panel-strong);
  color: var(--text);
  padding: 0 18px;
}

.primary-btn:hover,
.secondary-btn:hover {
  transform: translateY(-1px);
}

.error-box {
  background: rgba(178, 47, 47, 0.08);
  color: var(--danger);
  border: 1px solid rgba(178, 47, 47, 0.15);
  border-radius: 12px;
  padding: 10px 12px;
}

.auth-footer {
  margin-top: 18px;
  text-align: center;
  color: var(--muted);
}

.auth-footer a {
  color: var(--primary);
  font-weight: 700;
  text-decoration: none;
}

.dashboard-screen {
  max-width: 1200px;
  margin: 0 auto;
  padding: 32px 20px 64px;
}

.dashboard-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 24px;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--primary);
  font-size: 12px;
  font-weight: 700;
  margin: 0 0 6px;
}

.dashboard-header h1 {
  margin: 0;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card,
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 18px;
  box-shadow: 0 18px 36px var(--shadow);
}

.stat-card {
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stat-card span {
  color: var(--muted);
  font-size: 0.9rem;
}

.stat-card strong {
  font-size: 2rem;
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(320px, 1fr));
  gap: 20px;
}

.panel {
  padding: 20px;
}

.panel h3 {
  margin-top: 0;
}

.wide-panel {
  grid-column: 1 / -1;
}

.list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.list li {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 12px;
  align-items: center;
  border-bottom: 1px solid var(--border);
  padding-bottom: 12px;
}

.message-list li {
  grid-template-columns: 1fr;
  gap: 8px;
}

.dashboard-loading {
  min-height: 100vh;
  display: grid;
  place-items: center;
  font-size: 1.2rem;
  color: var(--muted);
}

@media (max-width: 800px) {
  .stats-grid,
  .content-grid {
    grid-template-columns: 1fr;
  }

  .dashboard-header {
    flex-direction: column;
    align-items: flex-start;
  }
}
