{
  "name": "earthguard",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node db/init.js",
    "client:install": "cd client && npm install",
    "client:dev": "cd client && npm run dev -- --host 0.0.0.0",
    "client:build": "cd client && npm run build",
    "build": "npm run client:build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  }
}
